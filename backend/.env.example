# Model provider: anthropic or gemini (default: whichever key is set, Anthropic first).
ORION_LLM=anthropic
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# The smart model plans and calls tools; the fast one extracts and checks.
# ORION_SMART_MODEL=claude-haiku-5-5
# ORION_FAST_MODEL=claude-haiku-5-5

# FalkorDB
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379

# Signs the persona tokens. Set a long random value on any public deployment.
# ORION_SECRET=
# Enables POST /api/corvane/reset when sent as X-Admin-Token.
# ORION_ADMIN_TOKEN=
# Browser origins allowed to call the API, comma separated.
ORION_CORS=http://localhost:3001
# A pattern for more origins, e.g. the web app's preview deployments.
# ORION_CORS_REGEX=^https://orion-[a-z0-9]+-yourteam\.vercel\.app$
# GitHub token for loading public repositories (falls back to `gh auth token`). Read-only public access is enough.
# GITHUB_TOKEN=
# Minutes between automatic syncs of loaded repositories (0: only when someone presses Update).
# ORION_GITHUB_POLL_MIN=0
# Simulator workers in the API process.
# ORION_WORKERS=2
# Model calls per visitor per hour.
# ORION_LLM_PER_HOUR=120

# FalkorDB Cloud (leave unset for a local FalkorDB)
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=true
